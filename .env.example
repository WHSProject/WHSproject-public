# WHSProject 공통 환경변수 예시 파일
# 각 Component의 환경변수 정보가 확정되면 변수명을 추가합니다.
# 실제 비밀번호, API Key, Token 등 민감한 값은 작성하지 않습니다.

# =========================
# Gateway
# =========================

# Gateway HTTP Port
GATEWAY_PORT=3000

# PostgreSQL connection
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Scanner
# 최종 MVP / Integration / Demo에서는 Scanner 분석과 Decision 집행 경로를 사용합니다.
# false는 Scanner 연동을 의도적으로 비활성화하는 로컬 개발용 옵션입니다.
SCANNER_ENABLED=true
SCANNER_URL=http://scanner:3001
# 동기 분석이 끝날 때까지 대기한다. 설치하는 쪽 npm fetch-timeout(360s로 설정)보다 짧아야 한다.
SCANNER_TIMEOUT_MS=300000

# 분석 기억 (Gateway)
# 의존성 트리 분석을 마친 Artifact를 몇 개까지 기억할지 정한다.
# 기억된 Artifact는 Arborist 트리 구성을 건너뛴다.
# Decision 조회와 집행은 건너뛰지 않으므로 판정 정확성에는 영향이 없다.
# 값이 작으면 트리를 더 자주 만들고, 크면 메모리를 더 쓴다.
ANALYSIS_CACHE_MAX_ENTRIES=5000

METADATA_TIMEOUT_MS=10000
METADATA_MAX_RESPONSE_BYTES=2097152
TARBALL_CONNECT_TIMEOUT_MS=5000
TARBALL_DOWNLOAD_TIMEOUT_MS=60000
MAX_TARBALL_BYTES=104857600
TARBALL_MAX_REDIRECTS=3
POLICY_URL=http://policy:8000
DECISION_DB_URL=http://decision-db-api:9100
FEED_CACHE_TIMEOUT_MS=750
OSV_REFRESH_WORKER_ENABLED=true
SCANNER_ADMIN_TOKEN=
POLICY_TIMEOUT_MS=30000
SCANNER_PACKAGE_TIMEOUT_MS=240000
OBFUSCATION_GPT_MODE=off
# Shadow에서 사용할 제공자를 하나 선택한다. 실제 키는 Git에 기록하지 않는다.
OBFUSCATION_LLM_PROVIDER=gpt
# OPENAI_API_KEY=
# GEMINI_API_KEY=
OBFUSCATION_GPT_MODEL=gpt-4o-mini
OBFUSCATION_GPT_BASE_URL=https://api.openai.com/v1
OBFUSCATION_GEMINI_MODEL=gemini-3.5-flash
OBFUSCATION_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OBFUSCATION_GPT_TIMEOUT_MS=20000
OBFUSCATION_GPT_MAX_OUTPUT_TOKENS=2048
# Tier3: disabled by default. Set LLM_AGENT_ENABLED=true to use the configured trigger/model.
LLM_AGENT_ENABLED=false
LLM_AGENT_TRIGGER_MODE=RISK_BASED
LLM_AGENT_PROVIDER=openai
LLM_AGENT_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
# Runtime defaults: 180 seconds for one whole Agent run (every model call and code request in it) and one retry.
LLM_AGENT_TIMEOUT_MS=180000
LLM_AGENT_MAX_RETRIES=1
# tier3 planning: Jev context check between slicing and the Agent. Runs only when Tier 3 runs; skipped when TYPESAFE_API_KEY is empty.
LLM_AGENT_CONTEXT_CHECK_ENABLED=true
LLM_AGENT_CONTEXT_CHECK_MODEL=jev-latest
LLM_AGENT_CONTEXT_CHECK_TIMEOUT_MS=3000
# Second Jev call on the contexts code was added for (one more call per such group). Off when unset.
LLM_AGENT_CONTEXT_RECHECK_ENABLED=false
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
OBFUSCATION_GPT_MODE=off

# Verdaccio
VERDACCIO_URL=http://verdaccio:4873
VERDACCIO_TIMEOUT_MS=60000

# Gateway와 Verdaccio가 공유하는 Approval API 서비스 인증 Secret.
# 무작위 값을 넣으면 compose가 두 서비스에 같은 값으로 전달한다. 예: openssl rand -hex 32
# 비워 두면 승인 등록이 401로 막혀 Gateway를 거친 설치가 실패한다.
# 값을 바꾸면 gateway와 verdaccio를 함께 다시 만든다(docker compose up -d --force-recreate gateway verdaccio).
# 실제 값은 Repository에 기록하지 않는다.
WHS_APPROVAL_SERVICE_TOKEN=

# Public npm Registry
NPM_REGISTRY_URL=https://registry.npmjs.org
NPM_REGISTRY_TIMEOUT_MS=30000

POLICY_PORT=8000
POLICY_LLM_MODE=openai
POLICY_LLM_MODEL=
POLICY_LLM_TIMEOUT_MS=20000
# off(기본), fixture 또는 openai. Shadow 결과는 실제 Decision에 영향을 주지 않는다.
POLICY_LLM_SHADOW_MODE=off
POLICY_LLM_SHADOW_MODEL=
# fixture 모드에서 evidence(기본), positive, negative를 선택할 수 있다.
POLICY_LLM_FIXTURE_SCENARIO=evidence
POLICY_LLM_FIXTURE_TARGET_PREDICATE=
# OPENAI_API_KEY / OPENAI_BASE_URL은 위 Tier3 설정과 공유한다.
# 실제 키는 .env 또는 런타임 Secret으로만 주입한다.
# Policy GPT·Claude 비교 Harness. 실제 Provider 호출은 CLI --live에서만 활성화한다.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
POLICY_LLM_HARNESS_GPT_MODEL=
POLICY_LLM_HARNESS_CLAUDE_MODEL=
POLICY_LLM_HARNESS_TIMEOUT_MS=20000
POLICY_LLM_HARNESS_MAX_OUTPUT_TOKENS=4096
# Pricing is optional external JSON configuration; do not put secrets here.
POLICY_LLM_PRICING_JSON=
EVIDENCE_API_PORT=8100
POLICY_DB_API_PORT=9000
DECISION_DB_API_PORT=9100
POLICY_DB_URL=http://policy-db-api:9000
EVIDENCE_DB_URL=http://evidence-api:8100
POLICY_DB_TIMEOUT_SECONDS=5
DECISION_DB_URL=http://decision-db-api:9100
DECISION_DB_TIMEOUT_SECONDS=5

# =========================
# Verdaccio
# =========================

# Gateway의 외부 노출 주소(스킴 포함, 경로 접두사는 제외).
# 접두사는 config.yaml 의 url_prefix(/npm/)가 담당하며 둘이 조합된다.
#   개발: http://localhost:3000  ->  http://localhost:3000/npm/{pkg}/-/{file}.tgz
#   운영: https://<gateway>      ->  Gateway 실제 주소로 변경할 것
VERDACCIO_PUBLIC_URL=http://localhost:3000

# 저장소 구성. local(기본, Docker Volume) 또는 s3(AWS S3).
# 비워 두면 local 이다.
# WHS_STORAGE_MODE=local

# WHS_STORAGE_MODE=s3 일 때만 쓴다. 쓰지 않는 값은 주석으로 남겨 둘 것.
# 빈 값(KEY=)으로 두면 S3 Plugin 이 변수 이름을 값으로 써서 연결에 실패한다.
# 인증은 IAM Role 을 쓰면 키 두 개를 넣지 않는다.
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3 호환 저장소(MinIO 등)를 쓸 때만 넣는다. AWS 는 비워 둔다.
# AWS_ENDPOINT_URL_S3=

# 초기 계정 생성 시에만 사용 (infra/verdaccio/scripts/bootstrap-users.sh).
# .env 에 남기지 말고 실행 시점에만 셸 환경변수로 전달할 것.
# VERDACCIO_READER_PASSWORD 는 아래 VERDACCIO_SERVICE_PASSWORD 와 같은 값이어야 한다.
# VERDACCIO_ADMIN_PASSWORD=
# VERDACCIO_CI_PASSWORD=
# VERDACCIO_READER_PASSWORD=

# =========================
# Dashboard
# =========================

# Dashboard 호스트 공개 포트. 127.0.0.1에만 바인딩한다.
# 개발 서버(npm run dev)와 같은 포트이므로 둘을 동시에 실행하지 않는다.
DASHBOARD_PORT=5173

# 브라우저가 접속하는 Dashboard 외부 주소. 인증(Better Auth) 설정에서 사용한다.
# 쿠키 도메인을 맞추기 위해 127.0.0.1이 아니라 localhost로 쓴다.
DASHBOARD_PUBLIC_URL=http://localhost:5173

# Better Auth가 로그인 쿠키·토큰의 서명과 암호화에 쓰는 비밀 키. Dashboard 로그인에 필요하다.
# 비어 있으면 로그인 API가 오류(500)를 낸다. 상태 검사(/api/health)와 로그인 화면은 비어 있어도 동작한다.
# 생성: openssl rand -base64 32. 실제 값은 Repository에 기록하지 않는다.
# 값을 바꾸면 모든 사용자가 다시 로그인해야 한다.
BETTER_AUTH_SECRET=

# Gateway → Verdaccio 읽기 전용 서비스 계정. 실제 비밀번호는 Secret으로 주입
VERDACCIO_SERVICE_USER=
VERDACCIO_SERVICE_PASSWORD=
